+  with self.assertRaisesRegex(ValueError,'CANCELLED'):
+   refunds.validate(replace(self.parsed,results=[RaceResult(16,'FINISHED',1,'2:00.0',None)]),refunds.parse_refunds(body('<p>返還馬番16番</p>')))
+ def test_repair_is_idempotent_preserves_learning_and_normal_payout(self):
+  before={t:[tuple(x) for x in self.s.c.execute('select * from '+t)] for t in ['races','horses','runners','results']}
+  b=body('<p>返還馬番16番</p>')
+  refunds.apply(self.s,self.parsed,b,None,'https://www.jra.go.jp/JRADB/accessS.html?CNAME=TEST')
+  refunds.apply(self.s,self.parsed,b,None,'https://www.jra.go.jp/JRADB/accessS.html?CNAME=TEST')
+  for t,rows in before.items():self.assertEqual(rows,[tuple(x) for x in self.s.c.execute('select * from '+t)])
+  self.assertEqual(self.s.c.execute("select payload_json from payouts where bet_type='WIN'").fetchone()[0],'{"payout_yen":480}')
+  self.assertEqual(self.s.c.execute('select count(*) from revisions').fetchone()[0],0)
+  self.assertEqual(refunds.audit(self.s.c,2024)['status'],'PASS')
+ def test_wrong_horse_and_status_do_not_write(self):
+  for parsed in [replace(self.parsed,entries=[replace(self.parsed.entries[0],horse_id='OTHER')]),replace(self.parsed,results=[replace(self.parsed.results[0],finish_status='取消')])]:
+   with self.assertRaises(ValueError):refunds.apply(self.s,parsed,body('<p>返還馬番16番</p>'),None,None)
+  self.assertEqual(self.s.c.execute('select count(*) from payouts').fetchone()[0],1)
+ def test_existing_refund_not_silently_deleted(self):
+  refunds.apply(self.s,self.parsed,body('<p>返還馬番16番</p>'),None,None)
+  with self.assertRaises(ValueError):refunds.apply(self.s,self.parsed,body('<p>none</p>'),None,None)
+ def test_absence_receipt_and_missing_coverage(self):
+  self.assertEqual(refunds.audit(self.s.c,2024)['remaining'],1)
+  refunds.apply(self.s,self.parsed,body('<p>none</p>'),None,None)
+  self.assertEqual(refunds.audit(self.s.c,2024)['status'],'PASS')
+ def test_resumes_only_unverified_pages(self):
+  url='https://www.jra.go.jp/JRADB/accessS.html?CNAME=OBSERVED';b=body('<p>返還馬番16番</p>')
