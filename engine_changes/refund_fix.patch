+  with patch('jra_master.person_repair.result_url',return_value=url),patch('jra_master.refunds.parse_result',return_value=self.parsed):
+   x=refunds.run(self.s,Client(),2024,self.tmp.name);y=refunds.run(self.s,Client(),2024,self.tmp.name)
