+  self.s.c.execute("delete from payouts where bet_type='REFUND'")
+  self.assertEqual(refunds.audit(self.s.c,2024)['receipt_data_mismatches'],1)
+ def test_split_horse_frame_nodes(self):
+  row=refunds.parse_refunds(body('<dl><dt>返還</dt><dd><strong>返還馬番16番</strong><strong>返還同枠8枠</strong></dd></dl>'))[0]
+  self.assertEqual(row['refund_frame_numbers'],[8])
+
+ def test_normal_collection_parses_refund_and_stores_receipt(self):
+  from jra_master.racing import integrate_result
+  html=body('<table><thead><th class="place">着順</th></thead><tbody><tr><td class="num">16</td><td class="horse">TEST</td></tr></tbody></table><dl><dt>返還</dt><dd>返還馬番16番</dd></dl>')
+  sid=self.s.source(dict(service='JRA',role='RESULT_HTML',url='https://www.jra.go.jp/JRADB/accessS.html'));self.s.c.commit()
