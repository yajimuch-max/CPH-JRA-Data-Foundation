+   self.s.c.execute('insert into payouts values(?,?,?,?)',(RID,'WIN',1,'{"payout_yen":480}'))
+ def tearDown(self):self.s.c.close();self.tmp.cleanup()
+ def test_official_text_and_fullwidth(self):
+  for text in ['<dl><dt>返還</dt><dd>返還馬番　16番</dd></dl>','<table><tr><th>返還</th><td><span>返還馬番</span><b>１６番、１番</b> 返還同枠 ８枠</td></tr></table>']:
+   rows=refunds.parse_refunds(body(text));self.assertIn(16,rows[0]['refund_horse_numbers']);self.assertIsNone(rows[0]['payout_yen'])
+  self.assertEqual(rows[0]['refund_frame_numbers'],[8]);self.assertEqual(rows[0]['refund_horse_numbers'],[1,16])
+ def test_absent_is_not_generic_footer(self):
+  self.assertEqual(refunds.parse_refunds(body('<p>返還の対象となります</p>')),[])
+ def test_malformed_is_not_none(self):
