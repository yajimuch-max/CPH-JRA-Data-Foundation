+import json,tempfile,unittest
+from pathlib import Path
+from dataclasses import replace
+from unittest.mock import patch
+from jra_master import refunds
+from jra_master.store import Store
+from jra_master.model import ParsedRace,RaceEntry,RaceResult
+
+RID='2024-04-14-中山-11'
+def body(text):return ('<html>'+text+'</html>').encode('cp932')
+class RefundTests(unittest.TestCase):
+ def setUp(self):
+  self.tmp=tempfile.TemporaryDirectory();self.s=Store(Path(self.tmp.name)/'MASTER.sqlite3');self.s.meta('year',2024)
+  e=RaceEntry(16,8,'2021100001','TEST','牡3',57.,None,'騎手',None,'調教師',500,None)
+  self.parsed=ParsedRace('2024-04-14','中山','3回中山8日',11,'皐月賞','芝',2000,'芝右','15:40','晴','良','GⅠ',[e],[RaceResult(16,'除外',None,None,None)])
+  with self.s.c:
+   self.s.c.execute('insert into races values(?,?,?,?,?,?)',(RID,'2024-04-14','中山',11,'FLAT','{}'))
+   self.s.c.execute('insert into horses values(?,?)',(e.horse_id,e.horse_name))
